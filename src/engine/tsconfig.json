{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "typeRoots": ["../frontend/node_modules/@types"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@engine/*": ["./src/*"],
      "zod": ["../frontend/node_modules/zod"],
      "zod/*": ["../frontend/node_modules/zod/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
